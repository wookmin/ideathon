PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=

# One of: sandbox, development, production
CODEF_ENV=development
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=

# Use a long random string in production.
APP_ENCRYPTION_SECRET=

GOOGLE_PLACES_API_KEY=

# Apps in Toss mTLS files. Keep these files outside the repository.
TOSS_MTLS_CERT_PATH=/secure/path/mumchit_public.crt
TOSS_MTLS_KEY_PATH=/secure/path/mumchit_private.key
TOSS_PAY_BASE_URL=https://pay-apps-in-toss-api.toss.im
